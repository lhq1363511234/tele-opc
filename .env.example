# Tele-OPC OS environment example
# Copy this file to .env and fill real values.
# Never commit .env to Git.

# App
APP_ENV=development
APP_NAME=Tele-OPC OS
PUBLIC_BASE_URL=http://localhost:3000
APP_ENCRYPTION_KEY=change-me-use-a-strong-random-key
LOG_LEVEL=info

# Database and queue
# Local development uses localhost. Docker Compose overrides these URLs so
# containers can reach postgres/redis by service name.
DATABASE_URL=postgresql://tele_opc:tele_opc_password@localhost:5432/tele_opc
REDIS_URL=redis://localhost:6379/0

# Docker Compose database container settings
POSTGRES_USER=tele_opc
POSTGRES_PASSWORD=tele_opc_password
POSTGRES_DB=tele_opc

# Telegram
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_OWNER_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=change-me-random-webhook-secret
# Optional. Useful in regions where api.telegram.org needs a local HTTP proxy.
TELEGRAM_PROXY_URL=

# AI provider
AI_PROVIDER=openai
AI_AGENT_ENABLED=true
OPENAI_BASE_URL=https://newapi.opctoai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=grok-4.5
OPENAI_TIMEOUT_MS=60000

# Telegram -> local Codex bridge.
# inbox: only write Telegram messages to runtime/codex-inbox.jsonl.
# exec: run `codex exec resume <session>` and send the final response back to Telegram.
CODEX_BRIDGE_ENABLED=false
CODEX_BRIDGE_MODE=inbox
CODEX_BRIDGE_CLI_PATH=codex
CODEX_BRIDGE_SESSION=last
CODEX_BRIDGE_TIMEOUT_MS=180000
CODEX_BRIDGE_DANGEROUS_BYPASS=false
CODEX_BRIDGE_INBOX_PATH=runtime/codex-inbox.jsonl
CODEX_BRIDGE_MAX_PROMPT_CHARS=8000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-4-sonnet
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1

# Prospecting public source connector
# Optional. Comma-separated entries: name|https://example.com/directory|directory
# source type can be search, directory, map, jobs, company_registry, or news.
PROSPECTING_PUBLIC_SOURCE_URLS=

# Memory / embeddings
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Browser automation
BROWSER_HEADLESS=true
BROWSER_STORAGE_DIR=./runtime/browser
BROWSER_SCREENSHOT_DIR=./runtime/artifacts/screenshots
BROWSER_ALLOWED_DOMAINS=stripe.com,github.com,google.com
BROWSER_REQUIRE_APPROVAL_FOR_SUBMIT=true

# External AppOS / CPS matrix
APPOS_API_BASE_URL=http://127.0.0.1:3000
APPOS_FEISHU_BASE_APP_TOKEN=
APPOS_FEISHU_TABLE_MAP_JSON=
APPOS_FEISHU_APP_ID=
APPOS_FEISHU_APP_SECRET=
APPOS_FEISHU_MIRROR_ENABLED=false
APPOS_FEISHU_AUTO_SYNC_INTERVAL_MS=60000
APPOS_DIFY_INBEIDOU_WEBHOOK_URL=
CLOAKBROWSER_MANAGER=http://127.0.0.1:8080
CLOAKBROWSER_PROFILE=
CPS_OUTPUT_DIR=runtime/inbeidou-cps-output
CPS_EDIT_BRIEF_PATH=D:/360MoveData/Users/Cir/Desktop/剪辑思路.txt
INBEIDOU_CPS_SCRAPER_SCRIPT=runtime/inbeidou-cps-skill/inbeidou-cps/scripts/cps_scrape.py

# Google OAuth for Gmail and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Email fallback / IMAP, optional
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Campaign email SMTP sender. Gmail: smtp.gmail.com:465 with SMTP_SECURE=true.
# Use a Gmail app password, not your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Finance integrations, optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Runtime behavior
DAILY_BRIEFING_CRON=0 8 * * *
WEEKLY_REVIEW_CRON=0 18 * * 5
DEFAULT_TIMEZONE=Asia/Shanghai
REQUIRE_APPROVAL_FOR_EXTERNAL_ACTIONS=true


# Web Console auth
# auto: open in development/test, telegram-required in production
# open: no auth (local only)
# telegram: require valid Telegram Mini App initData from owner allowlist
WEB_CONSOLE_AUTH_MODE=auto
# Optional local bypass token for production-like testing of the web console.
# Send as header: x-tele-opc-dev-token
WEB_CONSOLE_DEV_TOKEN=

# Paperclip control-plane integration
# Paperclip HTTP adapter calls Tele-OPC; Tele-OPC updates the Paperclip issue through its API.
PAPERCLIP_ENABLED=false
PAPERCLIP_API_URL=http://127.0.0.1:3101
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_WEBHOOK_SECRET=
PAPERCLIP_HEARTBEAT_WAIT_MS=12000
